":["TallyResult",0]}],"span":{"data":{"file_id":0,"beg":{"line":115,"col":0},"end":{"line":123,"col":1}},"generated_from_span":null},"source_text":"pub struct TallyResult {\n    pub winners: Vec<Addr>,\n    pub per_round_counts: Vec<RoundCounts>,\n    pub eliminated_by_round: Vec<Vec<Addr>>,\n    pub ballots_tallied: u32,\n    pub ballots_dropped: u32,\n    pub dropped_voters: Vec<Addr>,\n    pub non_voters: Vec<Addr>,\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":0,"beg":{"line":116,"col":4},"end":{"line":116,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"winners","ty":{"Deduplicated":3621}},{"span":{"data":{"file_id":0,"beg":{"line":117,"col":4},"end":{"line":117,"col":42}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"per_round_counts","ty":{"Deduplicated":3624}},{"span":{"data":{"file_id":0,"beg":{"line":118,"col":4},"end":{"line":118,"col":43}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"eliminated_by_round","ty":{"Deduplicated":3625}},{"span":{"data":{"file_id":0,"beg":{"line":119,"col":4},"end":{"line":119,"col":28}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"ballots_tallied","ty":{"Deduplicated":912}},{"span":{"data":{"file_id":0,"beg":{"line":120,"col":4},"end":{"line":120,"col":28}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"ballots_dropped","ty":{"Deduplicated":912}},{"span":{"data":{"file_id":0,"beg":{"line":121,"col":4},"end":{"line":121,"col"