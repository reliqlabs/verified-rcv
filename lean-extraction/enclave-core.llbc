comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":449,"col":0},"end":{"line":449,"col":1}},"generated_from_span":null},"id":1369,"kind":{"StorageDead":8},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":449,"col":0},"end":{"line":449,"col":1}},"generated_from_span":null},"id":1370,"kind":{"Drop":[{"kind":{"Local":6},"ty":{"Deduplicated":3626}},{"kind":{"Trait":[{"Deduplicated":3696},0,59]},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}},"Conditional"]},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":449,"col":0},"end":{"line":449,"col":1}},"generated_from_span":null},"id":1371,"kind":{"StorageDead":6},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":449,"col":0},"end":{"line":449,"col":1}},"generated_from_span":null},"id":1372,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":449,"col":1},"end":{"line":449,"col":1}},"generated_from_span":null},"id":1373,"kind":"Return","comments_before":[]}]},"comments":[[320,["Copy the slice into a local Vec so the inner loops have a stable","type to walk; Aeneas / charon handle `Vec` more cleanly than","slice refs in some patterns."]],[326,["Initial `remaining` is the candidate-declaration-ordered set."]],[332,["Edge case: zero candidates. All-abstain over empty candidates","produces no winners, no rounds. (Out of band of intent §2.5","which assumes candidates is non-empty, but kept as a total","function for extraction.)"]],[346,["The IRV recursion is bounded by `|candidates|`. We use a counter","cap rather than open recursion so extraction sees an explicit","termination measure. The `+ 1` is a defensive overshoot the","algorithm never reaches; every iteration either breaks on a","terminal condition or strictly shrinks `remaining` by >= 1."]],[356,["Defensive bound. The termination measure (remaining","strictly shrinks each non-terminal round) means this is","unreachable; we treat current remaining as co-winners."]],[361,["Tally first-preferences against the current `remaining` set."]],[369,["Rule 1 (base case): empty remaining. Spec §2.5 case 5","(\"all abstain\") is handled below via the zero-total path;","here we catch a recursion that has emptied remaining (cannot","happen given the multi-winner fallback rule 4, but guarded","for totality)."]],[375,["Rule 1 (base case): single candidate left — sole winner."]],[383,["Rule 5 (all-abstain): no active votes this round. Per §2.5","case 5, declare all original candidates as co-winners with","a single zero-count round and no eliminations."]],[391,["Pin the just-recorded round to the all-zero counts over","the original candidate set, per the intent text:","\"per_round_counts = [{c: 0 for c in candidates}]\".","In the common all-abstain entry path (zero valid ballots","on the first iteration), `remaining == candidates`, so","the replacement is a no-op; the path stays uniform."]],[410,["Rule 2 (majority termination): count[c] > total / 2 for some c.","Integer division floors total / 2; the majority test is strict."]],[420,["Fall through to recursive case."]],[424,["Rules 3 + 4: batch elimination with terminal-tie fallback."]],[431,["Rule 4 (terminal tie): if losers == remaining (all remaining","tied at min, batch elimination would empty remaining),","declare all current `remaining` candidates as co-winners.","No elimination is recorded for this terminal round."]],[437,["Rule 3 proper: eliminate the losers, recurse."]]]}}},{"def_id":11,"item_meta":{"name":[{"Ident":["verified_rcv_enclave_core",0]},{"Ident":["decrypt_and_validate",0]}],"span":{"data":{"file_id":0,"beg":{"line":455,"col":0},"end":{"line":464,"col":1}},"generated_from_span":null},"source_text":"pub fn decrypt_and_validate(\n    _raw: &RawBallots,\n    _candidates: &CandidateSet,\n    _privkey: &PrivKey,\n) -> DecryptedSet {\n    unimplemented!(\n        \"decrypt_and_validate runs in the enclave runtime; \\\n         this crate provides the type signature on